# Local application
APP_ORIGIN="http://127.0.0.1:3000"
DATA_DIR="./data"

# Server-only credentials. Required on Vercel; leave blank for local SQLite.
DATABASE_URL=""
BLOB_READ_WRITE_TOKEN=""

# EmailJS browser integration. These identifiers are intentionally public.
# Restart development / rebuild after changing NEXT_PUBLIC_ values.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=""
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=""
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=""

# Defaults for a new database. For existing content, run npm run config:sync.
# Admin edits continue working; these defaults do not override each request.
RESERVATION_EMAIL="reservation@bluewavelodge.com"
CONTACT_EMAIL="contact@bluewavelodge.com"
CONTACT_PHONE="+212 696985757"
CONTACT_SECOND_PHONE="+212 696991149"

# Optional CLI provisioning/reset: npm run admin:owner -- --from-env
# Existing passwords cannot be recovered. Setting these alone does not reset login.
OWNER_EMAIL="reservation@bluewavelodge.com"
OWNER_PASSWORD="Yassine123@123"
